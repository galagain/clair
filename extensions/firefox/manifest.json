{
  "manifest_version": 3,
  "name": "Clair Coding",
  "version": "0.23.0",
  "description": "Envoyez un énoncé et du code à Clair, uniquement à votre demande.",
  "browser_specific_settings": {
    "gecko": {
      "id": "coding@clair.galagain",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Clair Coding",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "commands": {
    "send-to-clair": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Envoyer la page à Clair et analyser"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*"
  },
  "background": {
    "scripts": [
      "background.mjs"
    ],
    "type": "module"
  }
}
